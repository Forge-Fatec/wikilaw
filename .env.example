# START SONARQUBE AND INSERT PERMANENT TOKEN HERE
SONAR_TOKEN=token-here


POSTGRES_DB=wikilaw
POSTGRES_USER=wikilaw
POSTGRES_HOST_PORT=5433
# Set 0.0.0.0 on the server to allow other computers to access port 3000.
WIKILAW_BIND_ADDRESS=127.0.0.1
WIKILAW_VECTOR_ENABLED=true
WIKILAW_EMBEDDING_THREADS=2
WIKILAW_IMPORT_WORKER_ENABLED=true
WIKILAW_IMPORT_POLL_DELAY=1000
WIKILAW_BOOTSTRAP_JURISPRUDENCIA_ENABLED=true
WIKILAW_BOOTSTRAP_JURISPRUDENCIA_COMPLETO=true
POSTGRES_PASSWORD=change-me

# Obtenha a chave publica vigente na documentacao oficial do CNJ.
DATAJUD_API_KEY=
DATAJUD_BASE_URL=https://api-publica.datajud.cnj.jus.br
DATAJUD_CONNECT_TIMEOUT=5s
DATAJUD_READ_TIMEOUT=30s
DATAJUD_MAX_RETRIES=2
DATAJUD_RETRY_DELAY=500ms

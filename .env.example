# START SONARQUBE AND INSERT PERMANENT TOKEN HERE
SONAR_TOKEN=token-here


POSTGRES_DB=wikilaw
POSTGRES_USER=wikilaw
POSTGRES_HOST_PORT=5433
# Set 0.0.0.0 on the server to allow other computers to access port 3000.
WIKILAW_BIND_ADDRESS=127.0.0.1
WIKILAW_VECTOR_ENABLED=true
WIKILAW_EMBEDDING_THREADS=2
WIKILAW_IMPORT_WORKER_ENABLED=true
WIKILAW_IMPORT_POLL_DELAY=1000
WIKILAW_BOOTSTRAP_JURISPRUDENCIA_ENABLED=true
WIKILAW_BOOTSTRAP_JURISPRUDENCIA_COMPLETO=true
POSTGRES_PASSWORD=change-me

# Obtenha a chave publica vigente na documentacao oficial do CNJ.
DATAJUD_API_KEY=
DATAJUD_BASE_URL=https://api-publica.datajud.cnj.jus.br
DATAJUD_CONNECT_TIMEOUT=5s
DATAJUD_READ_TIMEOUT=30s
DATAJUD_MAX_RETRIES=2
DATAJUD_RETRY_DELAY=500ms

# Google Gemini: uma chave para a analise juridica e para os embeddings da busca semantica.
# Crie a chave em https://aistudio.google.com/apikey
WIKILAW_GEMINI_API_KEY=
# Libera o botao "Analisar com IA".
WIKILAW_GEMINI_ENABLED=false
WIKILAW_GEMINI_MODEL=gemini-2.5-flash

# Embeddings semanticos com o Gemini. Defina true para o worker gerar os vetores do acervo.
# Trocar de provedor ou de modelo faz o worker gerar de novo os vetores de todo o acervo.
WIKILAW_EMBEDDING_ENABLED=false
WIKILAW_EMBEDDING_PROVIDER=gemini
WIKILAW_EMBEDDING_MODEL=gemini-embedding-001
WIKILAW_EMBEDDING_DIMENSIONS=1024
# Para voltar a Voyage AI: PROVIDER=openai-compatible, BASE_URL=https://api.voyageai.com,
# MODEL=voyage-4, SEND_INPUT_TYPE=true e a chave da Voyage em WIKILAW_EMBEDDING_API_KEY.
